# Copy to .env and fill in. Never commit .env.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# auto = Gemini if a key is set, otherwise offline mode (rules and templates, no AI)
LLM_PROVIDER=auto
GEMINI_MODEL=gemini-3.5-flash-lite

# tfidf = free local search (default). gemini = embedding search, uses your free quota.
RETRIEVER=tfidf
EMBED_MODEL=gemini-embedding-001

# Drafts per minute per visitor. Keeps a public demo inside the free tier.
RATE_LIMIT_PER_MINUTE=8
